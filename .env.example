# Steam Web API key — required. Get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Your Steam64 ID — always whitelisted and granted access to /admin.
ADMIN_STEAM_ID=

# Comma-separated Steam64 IDs allowed in addition to ADMIN_STEAM_ID and the DB-backed whitelist.
STEAM_WHITELIST_IDS=

# Base URL used as the Steam OpenID realm/return_to and for absolute metadata URLs; falls back to the request origin.
NEXTAUTH_URL=http://localhost:3000

# Overrides the SQLite database file path (defaults to /data/ when writable, else .data/ in the project root).
SQLITE_PATH=

# Currency used to value inventories via the Steam Market: USD | GBP | EUR (default USD).
STEAM_MARKET_CURRENCY=USD

# Bearer token required by GET /api/cron/snapshot-inventory (the daily snapshot cron fails closed if unset).
CRON_SECRET=

# HMAC key used to sign the session cookie. Required in production — falls
# back to STEAM_API_KEY in development/test only.
SESSION_SECRET=

# Node environment: development | production | test (default development). Usually set automatically by tooling.
NODE_ENV=development

# App version shown in the UI footer (build-time, public).
NEXT_PUBLIC_APP_VERSION=

# IANA timezone used to render timestamps in the UI; falls back to the browser's timezone.
NEXT_PUBLIC_DISPLAY_TIMEZONE=

# Pino log level (default "info").
LOG_LEVEL=info
